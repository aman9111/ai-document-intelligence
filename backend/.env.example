# Copy this file to .env and fill in the values (for running without Docker)

DATABASE_URL=postgresql://user:password@localhost:5432/ai_document_intelligence
# Long random string, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Any OpenAI-compatible LLM provider (free key at https://console.groq.com)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Optional
# CORS_ORIGINS=http://localhost:5173
# UPLOAD_DIR=/path/to/uploads

# Settings for docker compose. Copy to .env and fill in:  cp .env.example .env

# Password for the app's database (any long random string)
POSTGRES_PASSWORD=change-me

# Signs login tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Free key from https://console.groq.com (leave empty to run without Ask AI)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Port on your computer where the app opens: http://localhost:8080
APP_PORT=8080
